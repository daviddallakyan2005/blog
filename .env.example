# Dashboard → Project Settings → API. Required at runtime for Auth clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by scripts/grant-owner.mjs and scripts/sync-github-prs.mjs
# (GitHub Action / trusted machine) — never expose to the browser or Vercel.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. PAT for public PR sync (Studio Sync now / local). Not OAuth login.
# GitHub Actions secret name is GH_PR_TOKEN (GITHUB_* names are reserved).
# GITHUB_PR_TOKEN=
# GITHUB_PR_AUTHOR=daviddallakyan2005

# Integration tests (tests/rls.test.ts). Copy to .env.test — never commit secrets.
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
