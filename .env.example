# Dashboard → Project Settings → API. Required at runtime for Auth clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by scripts/grant-owner.mjs — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Integration tests (tests/rls.test.ts). Copy to .env.test — never commit secrets.
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
